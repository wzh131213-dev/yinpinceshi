# Copy these values into your hosting provider's environment-variable settings.
# Never commit a real .env file or API key.
EMUTIZE_API_KEY=
EMUTIZE_BASE_URL=https://app.emutize.com
APP_ACCESS_PASSWORD=replace-with-a-long-random-password
# Set this to your exact deployed frontend origin, e.g. https://wzh131213-dev.github.io
ALLOWED_ORIGINS=
MAX_APK_MB=150
